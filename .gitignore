!export/android/debug.keystore

# gd-tools
.gd-tools/
*.gd.bak

# OS / editors
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
*.tmp
*.log

# Debug captures
shots/
# Godot's CSV sidecar for the ratings sheet is generated on import
data/*.csv.import

# Exports / builds
build/
dist/
*.apk
*.aab
*.ipa
*.exe
*.x86_64
*.app/
*.dmg

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# agent-orc (runtime + machine overrides; keep .orc/config.yaml tracked)
.orc/config.local.yaml
.orc/worktrees/
.orc/logs/

# Command Code local state
.commandcode/
